PORT=5000

# MySQL / MariaDB - the only database the API uses. XAMPP defaults shown.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=permit_declaration
DB_POOL_SIZE=10
# Hosted MySQL (Aiven etc.) requires TLS. Point DB_SSL_CA_PATH at the provider's CA
# certificate (on Render: a Secret File at /etc/secrets/aiven-ca.pem), or put the PEM
# text in DB_SSL_CA. Leave DB_SSL empty for local XAMPP.
DB_SSL=
DB_SSL_CA_PATH=

# Required in production (the API refuses to start without it when NODE_ENV=production).
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Browser origins allowed to call the API, comma separated. Wildcards cover Cloudflare
# Pages preview URLs, e.g. https://crm.pages.dev,https://*.crm.pages.dev
CLIENT_ORIGIN=http://localhost:5173
# NODE_ENV=production

# Initial admin login created during seed (optional defaults to admin / admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Email (Gmail SMTP) — used to send invoice PDFs to customers.
# SMTP_PASS must be a Gmail App Password (not the normal account password).
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=Your Company
# Bank details shown in the invoice email body
BANK_ACCOUNT_NAME=YOUR COMPANY PTE. LTD.
BANK_ACCOUNT_NO=000-0000-000
# Signature block for the invoice email
EMAIL_SIGNER_NAME=Accounts Team
EMAIL_SIGNER_TITLE=Accounts Manager

# Only needed once, for `npm run migrate:mongo` (copies the old MongoDB data into MySQL).
MONGODB_URI=mongodb+srv://<mongodb-user>:<mongodb-password>@<cluster-host>/<database>
MONGODB_DB=permit_declaration
