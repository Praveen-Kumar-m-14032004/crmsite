PORT=5000

MONGODB_URI=mongodb+srv://<mongodb-user>:<mongodb-password>@<cluster-host>/<database>
MONGODB_DB=permit_declaration
MONGODB_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

CLIENT_ORIGIN=http://localhost:5173

# Initial admin login created during seed (optional defaults to admin / admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin


# Migration-only source settings. Required only by npm run migrate:mysql.
# These values are for the legacy MySQL/MariaDB source, not MongoDB.

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=permit_declaration
