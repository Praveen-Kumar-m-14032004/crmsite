PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/permit_declaration
MONGODB_DB=permit_declaration
MONGODB_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

JWT_SECRET=change-this-to-a-long-random-string
